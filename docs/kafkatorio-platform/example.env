# Docker Compose settings - copy to `.env`

# the version of the Kafkatorio images you built (the `version` in build.gradle.kts)
KAFKATORIO_VERSION=0.10.1
# images are built locally, and tagged `localhost/dev.adamko.kafkatorio/...`
REGISTRY_HOST=localhost

# Only needed for the optional Factorio server (`docker compose --profile factorio up -d`)
# A factoriotools/factorio tag: https://hub.docker.com/r/factoriotools/factorio
FACTORIO_VERSION=stable
# The Factorio server's token - see "Create a token for the Factorio server" in docs/guide.md
KAFKATORIO_TOKEN=<jwt token>
