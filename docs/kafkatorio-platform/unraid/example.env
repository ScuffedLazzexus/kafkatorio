KAFKATORIO_VERSION=0.10.1
REGISTRY_HOST=localhost
# persistent data, config, and secrets
APPDATA=/mnt/user/appdata/kafkatorio-platform
# Kafka data. Use a direct disk/pool path (e.g. /mnt/cache/... or /mnt/diskN/...), not /mnt/user/...
# Unraid's FUSE layer (shfs) is slow for Kafka's many small writes.
KAFKA_DATA_DIR=/mnt/disk1/appdata/kafkatorio-platform/kafka-data
